# Railway PostgreSQL Connection (Internal - for backend service)
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway

# Railway PostgreSQL Connection (Public - for migrations/local dev)
DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@tramway.proxy.rlwy.net:PORT/railway

# Redis Connection
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Environment
RAILWAY_ENVIRONMENT=production
NODE_ENV=production
PORT=3001

# Data Source API Keys
TIINGO_API_KEY=your_tiingo_key_here
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
FRED_API_KEY=your_fred_key_here
