# =================================================================
# GAYED SIGNALS DASHBOARD - ENVIRONMENT TEMPLATE
# =================================================================
# 📋 Copy this file to .env and fill in your actual API keys
# ⚠️ NEVER commit real API keys to version control

# =================================================================
# REQUIRED API KEYS
# =================================================================
# Get these from respective service providers

# Financial Data APIs (Required for core functionality)

# Tiingo API Key (Primary financial data source)
TIINGO_API_KEY=36181da7f5290c0544e9cc0b3b5f19249eb69a61

# Alpha Vantage API Key (Backup financial data source)  
ALPHA_VANTAGE_KEY=QM5V895I65W014U0
FRED_KEY=your_fred_api_key_here
FRED_API_KEY=your_fred_api_key_here
BUREAU_OF_STATISTIC_KEY=your_bls_api_key_here

# AI Processing APIs (Required for AI features)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# =================================================================
# OPTIONAL API KEYS
# =================================================================
# These enhance functionality but are not required

# News and Research APIs
GNEWS_API_KEY=your_gnews_api_key_here
PUBMED_API_KEY=your_pubmed_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Social Media APIs
REDDIT_API_KEY=your_reddit_api_key_here
REDDIT_PERSONAL_ID=your_reddit_id_here

# Government APIs
SEC_API_KEY=your_sec_api_key_here

# Cloud Services
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_URL=your_qdrant_cluster_url_here
SUPABASE_API_KEY=your_supabase_api_key_here
NIA_API_KEY=your_nia_api_key_here

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./video_insights.db

# Production (PostgreSQL) - Set in deployment platform
# DATABASE_URL=postgresql+asyncpg://username:password@host:port/database

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =================================================================
# SECURITY CONFIGURATION
# =================================================================
# Generate strong random values for production
SECRET_KEY=your-secret-key-change-in-production-this-should-be-very-secure-and-random
JWT_SECRET=your-jwt-secret-key-change-in-production

# =================================================================
# ENVIRONMENT SETTINGS
# =================================================================
NODE_ENV=development
ENVIRONMENT=development
FLASK_ENV=development
DEPLOYMENT_MODE=development

# =================================================================
# SERVICE URLS
# =================================================================
# Development URLs
FRONTEND_URL=http://localhost:3000
PYTHON_SERVICE_URL=http://localhost:5000
PYTHON_BACKEND_URL=http://localhost:5000
FASTAPI_BASE_URL=http://localhost:8002

# Railway Backend Configuration (V2 API)
NEXT_PUBLIC_RAILWAY_BACKEND_URL=https://gayed-backend-production.up.railway.app
NEXT_PUBLIC_RAILWAY_API_KEY=your_railway_api_key_here
RAILWAY_API_KEY=your_railway_api_key_here

# =================================================================
# CORS CONFIGURATION
# =================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# =================================================================
# PERFORMANCE SETTINGS
# =================================================================
MAX_ANALYSIS_TIME=600
INITIAL_CAPITAL=100000
COMMISSION_RATE=0.001
DATA_CACHE_SIZE=100
MAX_DATA_POINTS=10000
MIN_DATA_POINTS=50

# =================================================================
# LOGGING CONFIGURATION
# =================================================================
LOG_LEVEL=INFO
ENABLE_CONSOLE_LOGS=true
LOG_FILE=logs/app.log

# =================================================================
# SECURITY FEATURES
# =================================================================
SECURITY_HEADERS_ENABLED=true
RATE_LIMITING_ENABLED=true
CIRCUIT_BREAKER_ENABLED=true
SAFLA_ENABLED=true

# =================================================================
# FEATURE FLAGS
# =================================================================
ENABLE_PERFORMANCE_TRACKING=true
ENABLE_CORRELATION_ANALYSIS=true
ENABLE_CHART_GENERATION=true

# Railway Backend Feature Flag (set to 'true' to use Railway V2 API)
NEXT_PUBLIC_USE_RAILWAY_BACKEND=false

# =================================================================
# CHART CONFIGURATION
# =================================================================
CHART_OUTPUT_DIR=static/charts
CHART_DPI=150
CHART_FORMAT=png

# =================================================================
# PORT CONFIGURATION
# =================================================================
FRONTEND_PORT=3000
BACKEND_PORT=5000
FASTAPI_PORT=8002
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# =================================================================
# DEPLOYMENT PLATFORM SPECIFIC
# =================================================================
# Uncomment the section for your deployment platform

# Vercel
# VERCEL=1
# NEXT_RUNTIME=nodejs

# Railway
# RAILWAY_ENVIRONMENT=production
# RAILWAY_STATIC_URL=${Railway.STATIC_URL}

# Heroku
# HEROKU=1
# WEB_CONCURRENCY=1

# =================================================================
# DEVELOPMENT ONLY
# =================================================================
# These are only used in development
DEBUG=false
VERBOSE_LOGGING=false
MOCK_DATA_ENABLED=false

# =================================================================
# MONITORING (Optional)
# =================================================================
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true