# Story 4.0d: Railway Environment Variables for Signal Calculation Service
# Copy this file to .env for local development
# Railway auto-provides DATABASE_URL, REDIS_URL, and PORT in production

# ===== RAILWAY AUTO-PROVIDED (Production) =====
# These are automatically set by Railway in production
# DATABASE_URL=${{POSTGRES.DATABASE_URL}}
# DATABASE_PUBLIC_URL=${{POSTGRES.DATABASE_PUBLIC_URL}}
# REDIS_URL=${{REDIS.REDIS_URL}}
# PORT=${{PORT}}
# RAILWAY_ENVIRONMENT=production

# ===== LOCAL DEVELOPMENT =====
# For local development, set these manually
DATABASE_URL=postgresql://user:password@localhost:5432/gayed_signals?schema=public
DATABASE_PUBLIC_URL=postgresql://user:password@localhost:5432/gayed_signals?schema=public
REDIS_URL=redis://localhost:6379
PORT=3001

# ===== SIGNAL CALCULATION CONFIGURATION =====
SIGNAL_CALCULATION_ENABLED=true
SIGNAL_CALCULATION_INTERVAL=3600000  # 1 hour in milliseconds
SIGNAL_CALCULATION_TIMEOUT=60000     # 1 minute timeout

# ===== SIGNAL-SPECIFIC CONFIGURATION =====
# Gayed 8-Month Signal
GAYED_8M_ENABLED=true
GAYED_8M_SHORT_PERIOD=8
GAYED_8M_LONG_PERIOD=9
GAYED_8M_MIN_DATA_POINTS=20

# Gayed 20-Day Signal
GAYED_20D_ENABLED=true
GAYED_20D_PERIOD=20
GAYED_20D_MIN_DATA_POINTS=40

# Bollinger Bands Signal
BOLLINGER_ENABLED=true
BOLLINGER_PERIOD=20
BOLLINGER_STD_DEVIATIONS=2
BOLLINGER_OVERBOUGHT_THRESHOLD=0.8
BOLLINGER_OVERSOLD_THRESHOLD=0.2

# Aggregate Signal
AGGREGATE_ENABLED=true
AGGREGATE_WEIGHT_GAYED_8M=0.4
AGGREGATE_WEIGHT_GAYED_20D=0.3
AGGREGATE_WEIGHT_BOLLINGER=0.3

# ===== CACHE CONFIGURATION =====
SIGNAL_CACHE_TTL=3600           # Cache TTL in seconds (1 hour)
SIGNAL_CACHE_ENABLED=true
SIGNAL_CACHE_MAX_SIZE=1000      # Maximum cache entries

# ===== PERFORMANCE SETTINGS =====
SIGNAL_BATCH_SIZE=100           # Batch size for parallel calculations
SIGNAL_PARALLEL_WORKERS=4       # Number of parallel workers
SIGNAL_TIMEOUT_MS=5000          # Individual signal calculation timeout

# ===== VALIDATION SETTINGS =====
SIGNAL_MIN_DATA_QUALITY_SCORE=0.8   # Minimum data quality score (0-1)
SIGNAL_REQUIRE_PROVENANCE=true      # Require provenance tracking
SIGNAL_VALIDATE_BEFORE_CALC=true    # Validate data before calculation

# ===== LOGGING & MONITORING =====
LOG_LEVEL=info                  # debug, info, warn, error
SIGNAL_LOG_CALCULATIONS=true    # Log each calculation
SIGNAL_LOG_CACHE_HITS=false     # Log cache hit/miss
SIGNAL_METRICS_ENABLED=true     # Enable performance metrics

# ===== RAILWAY DEPLOYMENT =====
NODE_ENV=production             # development, staging, production
RAILWAY_HEALTH_CHECK_PATH=/health
RAILWAY_RESTART_POLICY=ALWAYS
