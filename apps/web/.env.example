# =================================================================
# GAYED SIGNALS DASHBOARD - ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env.local and replace all placeholder values
# with your actual API keys and configuration values
#
# SECURITY: Never commit .env.local or .env files to version control
# =================================================================

# =================================================================
# API KEYS (Required for all services)
# =================================================================

# NIA API Key
NIA_API_KEY=your_nia_api_key_here

# Tiingo API Key (Primary financial data source)
# Get your key at: https://api.tiingo.com
TIINGO_API_KEY=your_tiingo_api_key_here

# Alpha Vantage API Key (Backup financial data source)
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# FRED API Key (Federal Reserve Economic Data)
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Note: Docker expects FRED_KEY
FRED_KEY=your_fred_api_key_here
FRED_API_KEY=your_fred_api_key_here

# Bureau of Labor Statistics API Key
BUREAU_OF_STATISTIC_KEY=your_bls_api_key_here

# OpenAI API Key (for AI processing)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude AI processing)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# PostgreSQL Database (Production - Railway)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# SQLite Database (Development fallback)
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./video_insights.db

# =================================================================
# REDIS CONFIGURATION
# =================================================================

# Redis Cache Database
REDIS_URL=redis://localhost:6379/0

# Celery Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =================================================================
# SECURITY CONFIGURATION
# =================================================================

# Secret key for JWT tokens and encryption
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# =================================================================
# AUTHENTICATION (Clerk)
# =================================================================

# Clerk Authentication Keys
# Get your keys at: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# =================================================================
# SERVICE CONFIGURATION
# =================================================================

# Environment mode
NODE_ENV=development
ENVIRONMENT=development

# Service URLs
PYTHON_SERVICE_URL=http://localhost:5000
PYTHON_SERVICE_PORT=5000
PYTHON_BACKEND_URL=http://localhost:5001
FASTAPI_BASE_URL=http://localhost:8000

# Railway Backend (Production)
NEXT_PUBLIC_RAILWAY_BACKEND_URL=https://gayed-backend-production.up.railway.app
NEXT_PUBLIC_USE_RAILWAY_BACKEND=true
NEXT_PUBLIC_RAILWAY_API_KEY=your_railway_api_key_here

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
FASTAPI_PORT=8000

# =================================================================
# FLASK CONFIGURATION (Backend Service)
# =================================================================

FLASK_ENV=development
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
LOG_LEVEL=INFO
MAX_ANALYSIS_TIME=600
INITIAL_CAPITAL=100000
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# =================================================================
# DEVELOPMENT & DEBUGGING
# =================================================================

# Logging
LOG_LEVEL=info
ENABLE_CONSOLE_LOGS=true

# Safety settings
SAFLA_ENABLED=true
CIRCUIT_BREAKER_ENABLED=true
RATE_LIMITING_ENABLED=true

# Security headers
SECURITY_HEADERS_ENABLED=true

# Docker network
DOCKER_NETWORK=gayed-signals-network

# =================================================================
# ADDITIONAL API KEYS
# =================================================================

# QDrant Vector Database
QDRANT_KEY=your_qdrant_key_here
QDRANT_API_KEY=your_qdrant_api_key_here

# Perplexity API
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Supabase
SUPABASE_API_KEY=your_supabase_api_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Academic Sources
PUBMED_API_KEY=your_pubmed_api_key_here

# News Sources
GNEWS_API_KEY=your_gnews_api_key_here

# Financial Sources
BLOOMBERG_API_KEY=your_bloomberg_api_key_here
YAHOO_FINANCE_KEY=your_yahoo_finance_key_here

# Social Sources
REDDIT_API_KEY=your_reddit_api_key_here
REDDIT_PERSONAL_ID=your_reddit_personal_id_here
REDDIT_HOST=http://localhost:8080/

# Government Sources
SEC_API_KEY=your_sec_api_key_here
